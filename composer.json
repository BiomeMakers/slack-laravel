{
    "name": "biomemakers/slack-laravel",
    "version": "4.2.0",
    "description": "Laravel 12 integration for the nexylan/slack package.",
    "keywords": ["slack", "laravel"],
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "javfres",
            "email": "javfres@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/discovery": "^1.14",
        "psr/http-message": "^2.0",
        "davidchicharro/slack-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Javfres\\Slack\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0-dev",
            "dev-php8": "4.0-dev",
            "dev-laravel7": "4.0.1-dev",
            "dev-php8_laravel8": "4.0.3-dev",
            "dev-php8_laravel9": "4.0.4-dev",
            "dev-php82_laravel10": "4.0.5-dev",
            "dev-php82_laravel11": "4.0.6-dev",
            "dev-php83_laravel11": "4.1.0-dev",
            "dev-php83_laravel12": "4.2.0-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "laravel/framework": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "repositories": [
      {
        "type": "git",
        "url": "https://github.com/DavidChicharro/slack-laravel.git",
        "_type": "path",
        "_url": "../fork-slack-laravel"
      }
    ]
}
